# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/ark

# Redis
REDIS_URL=redis://redis:6379/0

# Security (Change in production!)
SECRET_KEY=dev-secret-key-change-it
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DEBUG=true # Enable interactive docs in development, set to false in production

# Email (Resend)
# RESEND_API_KEY=re_your_key_here
# EMAIL_FROM=Ark Messenger <onboarding@resend.dev>

# Setup Superuser (created automatically on startup if specified)
SUPERUSER_EMAIL=emai@email

# Restic backup (S3-compatible storage)
RESTIC_REPOSITORY=s3:https://s3.example.com/ark-api-restic
RESTIC_PASSWORD=change-me
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_REGION_NAME=eu-central-1
RESTIC_KEEP_DAILY=7
RESTIC_KEEP_WEEKLY=4
RESTIC_KEEP_MONTHLY=12
